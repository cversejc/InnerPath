# ============================================
# 辰鉴配置文件
# ============================================
# 使用说明：
# 1. 复制此文件为 .env：cp .env.example .env
# 2. 修改下面的配置项
# 3. 生产环境务必修改所有密码和密钥
# ============================================

# -------------------- DeepSeek AI --------------------
DEEPSEEK_API_KEY=sk-your-api-key-here
DEEPSEEK_API_URL=https://api.deepseek.com/v1/chat/completions
DEEPSEEK_MODEL=deepseek-v4-flash
# v4 默认开启思考模式；报告需要把预算留给可展示正文，默认关闭
DEEPSEEK_THINKING=false
DEEPSEEK_TIMEOUT_SECONDS=120
DEEPSEEK_MAX_TOKENS=8000

# -------------------- 应用配置 --------------------
APP_NAME=辰鉴 API
APP_VERSION=1.0.0
DEBUG=false
ENVIRONMENT=production
LOG_LEVEL=INFO
LOG_FORMAT=json

# -------------------- 报告生成 --------------------
# 多步模式会先建立确定性先天坐标，再分步生成解读；默认关闭
USE_MULTISTEP_GENERATION=false

# -------------------- 服务器 --------------------
HOST=0.0.0.0
PORT=8000

# -------------------- 数据库 --------------------
POSTGRES_DB=innerpath
POSTGRES_USER=innerpath
POSTGRES_PASSWORD=change_this_in_production

# 数据库连接（Docker环境自动配置）
DATABASE_URL=postgresql+asyncpg://innerpath:change_this_in_production@postgres:5432/innerpath
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# -------------------- Redis --------------------
REDIS_URL=redis://redis:6379/0
REDIS_CACHE_DB=1

# -------------------- JWT 认证 --------------------
SECRET_KEY=change-this-to-random-string-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# -------------------- CORS --------------------
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,https://yourdomain.com

# -------------------- 短信服务（可选）--------------------
SMS_PROVIDER=aliyun
SMS_ACCESS_KEY=your_access_key
SMS_SECRET_KEY=your_secret_key
SMS_SIGN_NAME=辰鉴
SMS_TEMPLATE_CODE=SMS_123456

# -------------------- 限流 --------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_SMS_PER_MINUTE=5
RATE_LIMIT_REPORT_PER_HOUR=10

# -------------------- Celery（可选）--------------------
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
CELERY_TASK_SERIALIZER=json
CELERY_RESULT_SERIALIZER=json
CELERY_ACCEPT_CONTENT=json
CELERY_TIMEZONE=Asia/Shanghai
