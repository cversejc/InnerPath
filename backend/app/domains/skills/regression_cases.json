{
  "version": "innerpath-skill-regression-v1",
  "cases": [
    {
      "skill_key": "report.final_validator",
      "case_key": "validator.blocked-prediction",
      "title": "确定性未来承诺",
      "description": "验证对报告中的确定性预测提出 BLOCK。",
      "input_data": {
        "profile": { "name": "Regression User" },
        "context": {
          "qa_input": {
            "application_context": { "context": { "focus_topics": ["career"] } },
            "confirmed_semantics": {
              "findings": [
                {
                  "finding_key": "finding.boundary",
                  "claim": "用户正在评估职业方向。"
                }
              ]
            },
            "narrative_plan": { "core_theme": "先验证，再决定。" },
            "report_fragments": [
              {
                "fragment_key": "report.direction",
                "revision_no": 1,
                "title": "职业方向",
                "content": "你一定会在今年获得晋升。",
                "source_snapshot": {
                  "findings": [{ "finding_key": "finding.boundary" }]
                }
              }
            ]
          }
        }
      },
      "expectation": {
        "path_equals": [
          { "path": ["issues", 0, "severity"], "value": "BLOCK" },
          { "path": ["issues", 0, "target_fragment_key"], "value": "report.direction" }
        ],
        "minimum_score": 1.0
      }
    },
    {
      "skill_key": "report.narrative_plan",
      "case_key": "narrative.confirmed-findings-only",
      "title": "叙事候选引用已确认判断",
      "description": "验证叙事候选只引用输入中的稳定 Finding 标识。",
      "input_data": {
        "profile": { "name": "Regression User" },
        "context": {
          "semantic_model": {
            "findings": [
              {
                "finding_key": "finding.stability-autonomy",
                "claim": "稳定需求与自主需求之间存在张力。",
                "confidence": "MEDIUM",
                "importance": "HIGH"
              }
            ],
            "analysis_fragments": [],
            "evidence": []
          }
        }
      },
      "expectation": {
        "minimum_array_length": [
          { "path": ["candidates"], "value": 2 }
        ],
        "allowed_finding_refs": ["finding.stability-autonomy"],
        "minimum_score": 1.0
      }
    },
    {
      "skill_key": "report.fragment_authoring",
      "case_key": "authoring.no-new-finding",
      "title": "写作片段不创建新判断",
      "description": "验证报告片段只使用已确认 Finding，缺少支撑时不补写。",
      "input_data": {
        "profile": { "name": "Regression User" },
        "context": {
          "semantic_model": {
            "findings": [
              {
                "finding_key": "finding.small-step",
                "claim": "先通过小步尝试收集决策信息。",
                "confidence": "MEDIUM",
                "importance": "MEDIUM"
              }
            ],
            "analysis_fragments": [],
            "evidence": []
          },
          "narrative_plan": { "core_theme": "先验证，再决定。" },
          "fragment_request": {
            "fragment_key": "report.direction",
            "title": "下一步方向"
          }
        }
      },
      "expectation": {
        "required_fields": ["status", "title", "content", "used_findings"],
        "allowed_finding_refs": ["finding.small-step"],
        "minimum_score": 1.0
      }
    }
